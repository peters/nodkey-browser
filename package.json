{
  "name": "nodkey-browser",
  "private": true,
  "version": "0.2.1",
  "description": "Nodkey for Firefox and Chromium: sign in with logins and codes from Nodkey on your iPhone",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.21 <25"
  },
  "scripts": {
    "dev": "node scripts/build.mjs --watch",
    "wasm": "node scripts/wasm.mjs",
    "locales": "node scripts/locales.mjs",
    "lint": "eslint --max-warnings 0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "pretest": "node scripts/wasm.mjs && cargo build --locked -q -p fake-relay",
    "test": "vitest run",
    "build": "node scripts/build.mjs",
    "validate": "npm run wasm && npm run lint && npm run format:check && npm run typecheck && npm test && npm run build",
    "e2e": "node tests/e2e/run.mjs",
    "store": "node scripts/store.mjs"
  },
  "dependencies": {
    "vue": "3.5.43"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/chrome": "0.3.5",
    "@types/node": "24.19.2",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/eslint-config-typescript": "14.9.0",
    "@vue/test-utils": "2.5.1",
    "eslint": "10.12.0",
    "eslint-plugin-vue": "10.11.1",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "prettier": "3.9.10",
    "puppeteer-core": "25.13.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "5.0.3",
    "vue-tsc": "3.3.13"
  }
}
