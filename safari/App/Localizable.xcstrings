            "state": "translated",
            "value": "O Nodkey está desativado no Safari."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "SafariでNodkeyはオフです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Safari에서 Nodkey가 꺼져 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Nodkey 已在 Safari 中关闭。"
          }
        }
