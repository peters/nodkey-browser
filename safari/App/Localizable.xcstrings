{
  "sourceLanguage": "en",
  "strings": {
    "Nodkey for Safari": {
      "shouldTranslate": false
    },
    "Sign in with logins, codes and passkeys from Nodkey on your iPhone. You approve every request with Face ID.": {
      "comment": "Machine translation; needs native review before a store release.",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Logg inn med innlogginger, koder og passnøkler fra Nodkey på iPhonen din. Du godkjenner hver forespørsel med Face ID."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Logga in med inloggningar, koder och nycklar från Nodkey på din iPhone. Du godkänner varje begäran med Face ID."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Log ind med logins, koder og adgangsnøgler fra Nodkey på din iPhone. Du godkender hver anmodning med Face ID."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melde dich mit Logins, Codes und Passkeys aus Nodkey auf deinem iPhone an. Du bestätigst jede Anfrage mit Face ID."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sesión con accesos, códigos y llaves de acceso de Nodkey en tu iPhone. Apruebas cada solicitud con Face ID."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous avec les identifiants, codes et clés d’identification de Nodkey sur votre iPhone. Vous approuvez chaque demande avec Face ID."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accedi con credenziali, codici e passkey di Nodkey sul tuo iPhone. Approvi ogni richiesta con Face ID."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Entre com logins, códigos e chaves-senha do Nodkey no seu iPhone. Você aprova cada pedido com o Face ID."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhoneのNodkeyにあるログイン情報、コード、パスキーでサインインします。すべてのリクエストはFace IDで承認します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone의 Nodkey에 있는 로그인 정보, 코드, 패스키로 로그인하세요. 모든 요청은 Face ID로 승인합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 iPhone 上 Nodkey 中的登录信息、验证码和通行密钥登录。每个请求都由你用面容 ID 批准。"
          }
        }
      }
    },
    "Nodkey is on in Safari.": {
      "comment": "Machine translation; needs native review before a store release.",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Nodkey er på i Safari."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nodkey är på i Safari."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Nodkey er slået til i Safari."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nodkey ist in Safari aktiviert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nodkey está activado en Safari."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nodkey est activé dans Safari."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nodkey è attivo in Safari."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Nodkey está ativado no Safari."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "SafariでNodkeyはオンです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Safari에서 Nodkey가 켜져 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Nodkey 已在 Safari 中开启。"
          }
        }
      }
    },
    "Nodkey is off in Safari.": {
      "comment": "Machine translation; needs native review before a store release.",
      "localizations": {
