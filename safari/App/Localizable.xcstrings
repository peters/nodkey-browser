          "stringUnit": {
            "state": "translated",
            "value": "Nodkey er av i Safari."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nodkey är av i Safari."
          }
        },
        "da": {
          "stringUnit": {
