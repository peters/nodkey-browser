    "Turn on Nodkey in Safari Settings, under Extensions.": {
      "comment": "Machine translation; needs native review before a store release.",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå på Nodkey i Safari-innstillingene, under Utvidelser."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå på Nodkey i Safaris inställningar, under Tillägg."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå Nodkey til i Safaris indstillinger under Udvidelser."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere Nodkey in den Safari-Einstellungen unter „Erweiterungen“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa Nodkey en los ajustes de Safari, en Extensiones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez Nodkey dans les réglages de Safari, sous Extensions."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva Nodkey nelle impostazioni di Safari, in Estensioni."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative o Nodkey nos ajustes do Safari, em Extensões."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Safariの設定の「機能拡張」でNodkeyをオンにします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Safari 설정의 확장 프로그램에서 Nodkey를 켜세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Safari 设置的“扩展”中开启 Nodkey。"
          }
        }
      }
    },
    "Allow Nodkey on all websites, so that it can fill in sign-in fields.": {
      "comment": "Machine translation; needs native review before a store release.",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillat Nodkey på alle nettsteder, så den kan fylle ut innloggingsfelt."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillåt Nodkey på alla webbplatser så att den kan fylla i inloggningsfält."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillad Nodkey på alle websteder, så den kan udfylde loginfelter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube Nodkey auf allen Websites, damit es Anmeldefelder ausfüllen kann."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite Nodkey en todos los sitios web para que pueda rellenar los campos de inicio de sesión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez Nodkey sur tous les sites web pour qu’il puisse remplir les champs de connexion."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti Nodkey su tutti i siti web, così può compilare i campi di accesso."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita o Nodkey em todos os sites para que ele preencha os campos de login."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サインイン欄に入力できるよう、すべてのWebサイトでNodkeyを許可します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그인 칸을 채울 수 있도록 모든 웹사이트에서 Nodkey를 허용하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在所有网站上允许 Nodkey，以便它填写登录字段。"
          }
        }
      }
    },
    "Click Nodkey in the Safari toolbar and pair it with Nodkey on your iPhone.": {
      "comment": "Machine translation; needs native review before a store release.",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Klikk på Nodkey i verktøylinjen i Safari og koble den til Nodkey på iPhonen din."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicka på Nodkey i Safaris verktygsfält och parkoppla det med Nodkey på din iPhone."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik på Nodkey i Safaris værktøjslinje, og par den med Nodkey på din iPhone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicke in der Safari-Symbolleiste auf Nodkey und kopple es mit Nodkey auf deinem iPhone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic en Nodkey en la barra de herramientas de Safari y vincúlalo con Nodkey en tu iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez sur Nodkey dans la barre d’outils de Safari et associez-le à Nodkey sur votre iPhone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai clic su Nodkey nella barra degli strumenti di Safari e abbinalo a Nodkey sul tuo iPhone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique no Nodkey na barra de ferramentas do Safari e emparelhe-o com o Nodkey no seu iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Safariのツールバーで「Nodkey」をクリックし、iPhoneのNodkeyとペアリングします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Safari 도구 막대에서 Nodkey를 클릭하고 iPhone의 Nodkey와 페어링하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Safari 工具栏中点按 Nodkey，并将其与 iPhone 上的 Nodkey 配对。"
          }
        }
      }
    },
